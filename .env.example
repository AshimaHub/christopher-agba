# Copy to .env.local when you are ready. Do not commit .env.local.
# Leave both blank to keep the current mailto inquiry and to load no analytics.

# Public form access key from https://web3forms.com — not an account password.
# Inquiries are confirmed on the site only after Web3Forms accepts them.
VITE_WEB3FORMS_ACCESS_KEY=

# Optional. Example: christopher-agba.onrender.com
# No analytics script is added until this is set and the site is rebuilt.
VITE_PLAUSIBLE_DOMAIN=
